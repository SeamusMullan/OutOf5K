@startuml OutOf5K-C4-Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title System Context Diagram for OutOf5K

Person(user, "CS2 Player", "A Counter-Strike 2 player who wants to analyze their gameplay and improve their skills")

System(outof5k, "OutOf5K", "Desktop application that helps CS2 players review gameplay, track statistics, and compare performance with professionals")

System_Ext(steam, "Steam Platform", "Valve's gaming platform - provides user authentication and match history")
System_Ext(hltv, "HLTV", "Esports statistics platform - provides professional player and match data")
System_Ext(faceit, "Faceit/ESEA", "Competitive gaming platforms - provides ranked match data and statistics")
System_Ext(cs2, "CS2 Game Files", "Local demo files (.dem) generated by Counter-Strike 2")

Rel(user, outof5k, "Reviews demos, analyzes stats, tracks improvement", "Desktop App")
Rel(outof5k, steam, "Authenticates users, fetches match history", "HTTPS/OAuth")
Rel(outof5k, hltv, "Fetches pro player stats and match data", "HTTPS/API")
Rel(outof5k, faceit, "Fetches competitive match data", "HTTPS/API")
Rel(outof5k, cs2, "Reads and parses demo files", "File System")

SHOW_LEGEND()

@enduml
